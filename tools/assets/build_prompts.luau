--!strict
--[[
	Builds generation prompts and briefs for every critter from the catalog and the style bible.

	    lune run tools/assets/build_prompts.luau          -- all critters
	    lune run tools/assets/build_prompts.luau fox      -- only ids containing "fox"

	Output (relative to the repo root, where you run it from):
	    assets/jobs/<id>/front.txt, side.txt, back.txt, icon.txt, brief.json
	    assets/jobs/INDEX.md

	The prompt text lives in tools/assets/Prompts.luau; the ANIMATIONS block here must match
	docs/style-bible.md.
]]

local fs = require("@lune/fs")
local serde = require("@lune/serde")
local process = require("@lune/process")

local critters = require("../../src/Shared/Data/Critters")
local Prompts = require("./Prompts")

-- The animation set every critter gets. The den idle is the critter's own `idle` line.
local CARRIED_ANIMATION = "sneaky walk while carried: tiptoes in the air and glances side to side, in on the "
	.. "heist, never struggling"
local function stolenAnimation(species): string
	return `gotcha pose when stolen: a quick {species.personality} gotcha, in on the joke, never sad or scared`
end

local BUDGETS = {
	Common = { triangles = 1500, texture = 512, heightStuds = 2 },
	Uncommon = { triangles = 1500, texture = 512, heightStuds = 2 },
	Rare = { triangles = 3000, texture = 1024, heightStuds = 2.5 },
	Epic = { triangles = 3000, texture = 1024, heightStuds = 3 },
	Legendary = { triangles = 5000, texture = 1024, heightStuds = 3.5 },
	Mythic = { triangles = 5000, texture = 1024, heightStuds = 4 },
	Secret = { triangles = 5000, texture = 1024, heightStuds = 4 },
}

local OUT = "assets/jobs"

local filter = process.args[1]

if not fs.isDir(OUT) then
	fs.writeDir(OUT)
end

local index = {
	"# Asset jobs",
	"",
	"Generated by tools/assets/build_prompts.luau. Do not edit by hand.",
	"",
	"| Id | Name | Tier | Body plan | Personality | Glow | Status |",
	"| --- | --- | --- | --- | --- | --- | --- |",
}

local count = 0
for _, species in critters do
	if filter and not string.find(species.id, filter, 1, true) then
		continue
	end
	local dir = `{OUT}/{species.id}`
	if not fs.isDir(dir) then
		fs.writeDir(dir)
	end

	fs.writeFile(`{dir}/front.txt`, Prompts.view(species, "Front"))
	fs.writeFile(`{dir}/side.txt`, Prompts.view(species, "Side"))
	fs.writeFile(`{dir}/back.txt`, Prompts.view(species, "Back"))
	fs.writeFile(`{dir}/icon.txt`, Prompts.icon(species))

	local budget = BUDGETS[species.tier]
	local brief = {
		id = species.id,
		name = species.name,
		tier = species.tier,
		look = species.look,
		personality = species.personality,
		bodyPlan = Prompts.ART[species.id].bodyPlan,
		pose = Prompts.pose(species),
		animations = {
			denIdle = `happy idle in the den: {species.idle}`,
			carried = CARRIED_ANIMATION,
			stolen = stolenAnimation(species),
		},
		palette = species.palette,
		eventOnly = species.eventOnly,
		budget = budget,
		humanArtPass = species.tier == "Legendary" or species.tier == "Mythic" or species.tier == "Secret",
		status = "prompts-ready",
		notes = "",
	}
	-- Keep a human's status and notes if the brief already exists.
	local briefPath = `{dir}/brief.json`
	if fs.isFile(briefPath) then
		local ok, existing = pcall(serde.decode, "json", fs.readFile(briefPath))
		if ok and type(existing) == "table" then
			brief.status = existing.status or brief.status
			brief.notes = existing.notes or brief.notes
		end
	end
	fs.writeFile(briefPath, serde.encode("json", brief, true))

	table.insert(
		index,
		`| {species.id} | {species.name} | {species.tier} | {brief.bodyPlan} | {species.personality} | {species.palette[1]} | {brief.status} |`
	)
	count += 1
end

if not filter then
	fs.writeFile(`{OUT}/INDEX.md`, table.concat(index, "\n") .. "\n")
end

print(`Wrote prompts for {count} critter(s) to {OUT}/`)
