--!strict
--[[
	Builds generation prompts and briefs for every critter from the catalog and the style bible.

	    lune run tools/assets/build_prompts.luau          -- all critters
	    lune run tools/assets/build_prompts.luau fox      -- only ids containing "fox"

	Output (relative to the repo root, where you run it from):
	    assets/jobs/<id>/front.txt, side.txt, back.txt, icon.txt, brief.json
	    assets/jobs/INDEX.md

	The STYLE and AVOID blocks must match docs/style-bible.md.
]]

local fs = require("@lune/fs")
local serde = require("@lune/serde")
local process = require("@lune/process")

local critters = require("../../src/Shared/Data/Critters")

local STYLE = "Stylized 3D game character for a cozy nighttime game. Chunky toy-like shapes, soft rounded "
	.. "silhouette, oversized head about 40 percent of body height, big expressive eyes, short stubby "
	.. "limbs. Matte toon-shaded body with one softly glowing feature. Clean simple shapes and "
	.. "textures, no fine detail. Readable silhouette at small size."

local AVOID = "Avoid photorealism, realistic fur strands, text, letters, logos, watermarks, existing cartoon "
	.. "characters, franchise mascots, human faces, weapons, gore, scary or sexualized features."

local BUDGETS = {
	Common = { triangles = 1500, texture = 512, heightStuds = 2 },
	Uncommon = { triangles = 1500, texture = 512, heightStuds = 2 },
	Rare = { triangles = 3000, texture = 1024, heightStuds = 2.5 },
	Epic = { triangles = 3000, texture = 1024, heightStuds = 3 },
	Legendary = { triangles = 5000, texture = 1024, heightStuds = 3.5 },
	Mythic = { triangles = 5000, texture = 1024, heightStuds = 4 },
	Secret = { triangles = 5000, texture = 1024, heightStuds = 4 },
}

local OUT = "assets/jobs"

local function viewPrompt(species, view: string): string
	local others = table.concat(species.palette, ", ", 2)
	return `{STYLE} Character: {species.name}, {species.look}. {view} view, neutral standing pose, `
		.. `full body, centered, orthographic camera, evenly lit, plain mid-grey background. `
		.. `Main glow color {species.palette[1]}; other colors {others}. {AVOID}`
end

local function iconPrompt(species): string
	return `{STYLE} Inventory icon of {species.name}, {species.look}. Three-quarter view, head and body `
		.. `centered and filling the frame, soft rim light, glow color {species.palette[1]}, `
		.. `plain background for removal. {AVOID}`
end

local filter = process.args[1]

if not fs.isDir(OUT) then
	fs.writeDir(OUT)
end

local index = {
	"# Asset jobs",
	"",
	"Generated by tools/assets/build_prompts.luau. Do not edit by hand.",
	"",
	"| Id | Name | Tier | Glow | Status |",
	"| --- | --- | --- | --- | --- |",
}

local count = 0
for _, species in critters do
	if filter and not string.find(species.id, filter, 1, true) then
		continue
	end
	local dir = `{OUT}/{species.id}`
	if not fs.isDir(dir) then
		fs.writeDir(dir)
	end

	fs.writeFile(`{dir}/front.txt`, viewPrompt(species, "Front"))
	fs.writeFile(`{dir}/side.txt`, viewPrompt(species, "Side"))
	fs.writeFile(`{dir}/back.txt`, viewPrompt(species, "Back"))
	fs.writeFile(`{dir}/icon.txt`, iconPrompt(species))

	local budget = BUDGETS[species.tier]
	local brief = {
		id = species.id,
		name = species.name,
		tier = species.tier,
		look = species.look,
		idleAnimation = species.idle,
		palette = species.palette,
		eventOnly = species.eventOnly,
		budget = budget,
		humanArtPass = species.tier == "Legendary" or species.tier == "Mythic" or species.tier == "Secret",
		status = "prompts-ready",
		notes = "",
	}
	-- Keep a human's status and notes if the brief already exists.
	local briefPath = `{dir}/brief.json`
	if fs.isFile(briefPath) then
		local ok, existing = pcall(serde.decode, "json", fs.readFile(briefPath))
		if ok and type(existing) == "table" then
			brief.status = existing.status or brief.status
			brief.notes = existing.notes or brief.notes
		end
	end
	fs.writeFile(briefPath, serde.encode("json", brief, true))

	table.insert(index, `| {species.id} | {species.name} | {species.tier} | {species.palette[1]} | {brief.status} |`)
	count += 1
end

if not filter then
	fs.writeFile(`{OUT}/INDEX.md`, table.concat(index, "\n") .. "\n")
end

print(`Wrote prompts for {count} critter(s) to {OUT}/`)
