--!strict
--[[
	Writes the world kit briefs and manifest (task P2.2). Run from the repo root:

	    lune run tools/assets/build_kit.luau

	Output:
	    assets/kit/jobs/<piece_id>/prompt.txt, brief.json
	    assets/kit/INDEX.md          brief list and credit estimate
	    assets/kit/manifest.json     piece id -> asset id, EMPTY until pieces are imported

	The manifest is only created if missing: after import it holds real asset ids, which a
	rebuild must never wipe. New pieces are added to it with an empty id.
]]

local fs = require("@lune/fs")
local serde = require("@lune/serde")

local Kit = require("./Kit")

local OUT = "assets/kit"

local function ensureDir(path: string)
	if not fs.isDir(path) then
		fs.writeDir(path)
	end
end

ensureDir(OUT)
ensureDir(`{OUT}/jobs`)

local index = {
	"# World kit",
	"",
	"Generated by tools/assets/build_kit.luau. Do not edit by hand. Nothing here is generated yet.",
	"",
	"| Id | Group | Size (studs) | Triangles | Parts | Glow |",
	"| --- | --- | --- | --- | --- | --- |",
}

local manifest: { [string]: string } = {}
if fs.isFile(`{OUT}/manifest.json`) then
	local existing = serde.decode("json", fs.readFile(`{OUT}/manifest.json`))
	manifest = existing.pieces or {}
end

for _, piece in Kit.PIECES do
	local dir = `{OUT}/jobs/{piece.id}`
	ensureDir(dir)
	fs.writeFile(`{dir}/prompt.txt`, Kit.prompt(piece) .. "\n")
	fs.writeFile(`{dir}/brief.json`, serde.encode("json", {
		id = piece.id,
		name = piece.name,
		group = piece.group,
		purpose = piece.purpose,
		sizeStuds = piece.size,
		budget = {
			triangles = piece.triangles,
			parts = piece.parts,
			texture = piece.texture,
			onScreenAtOnce = piece.repeats,
		},
		glow = if piece.glow then { at = piece.glowAt, color = Kit.GLOW_WORDS[piece.glow] } else nil,
		notes3d = piece.notes,
	}, true) .. "\n")
	if manifest[piece.id] == nil then
		manifest[piece.id] = ""
	end
	local glow = if piece.glow then piece.glow else "none"
	table.insert(
		index,
		`| {piece.id} | {piece.group} | {piece.size.x} x {piece.size.y} x {piece.size.z} | {piece.triangles} | {piece.parts} | {glow} |`
	)
end

local est = Kit.estimate(Kit.PIECES)
for _, line in
	{
		"",
		"## Credit estimate (when credits return)",
		"",
		`{est.pieces} pieces. Images: {est.images} at {Kit.IMAGE_COST} credit = {est.imageCredits}. `
			.. `Meshes: {est.meshes} at {Kit.MESH_COST} credits (includes {Kit.MESH_RETRY_RATE * 100} percent retries) = {est.meshCredits}.`,
		`**Total about {est.total} credits.** Images first, then stop for approval before any 3D (Gate 1).`,
		"",
	}
do
	table.insert(index, line)
end
fs.writeFile(`{OUT}/INDEX.md`, table.concat(index, "\n") .. "\n")

-- Sorted keys so the file diffs cleanly.
local ids: { string } = {}
for id in manifest do
	table.insert(ids, id)
end
table.sort(ids)
local lines: { string } = { "{", '\t"version": 1,', '\t"pieces": {' }
for i, id in ids do
	local comma = if i < #ids then "," else ""
	table.insert(lines, `\t\t"{id}": "{manifest[id]}"{comma}`)
end
table.insert(lines, "\t}")
table.insert(lines, "}")
fs.writeFile(`{OUT}/manifest.json`, table.concat(lines, "\n") .. "\n")

print(`wrote {#Kit.PIECES} kit pieces to {OUT}/, estimate {est.total} credits`)
